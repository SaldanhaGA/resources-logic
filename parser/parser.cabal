cabal-version:       >=1.10
name:                parser
version:             0.1.0.0
license-file:        LICENSE
author:              SaldanhaGA
maintainer:          gabrielsaldanha373@gmail.com
build-type:          Simple
extra-source-files:  CHANGELOG.md
                   , src/Syntax/specification.md

library
  exposed-modules:
      Lexer.Lexer
    , Syntax.Syntax
    , Parser.Parser
    , Semantics.State
    , Semantics.Interpreter
  build-tool-depends:  alex:alex
  build-depends:
      base >=4.13 && <5
    , megaparsec
    , parser-combinators
    , array
    , containers
    , aeson
    , bytestring
  hs-source-dirs:      src
  default-language:    Haskell2010

executable parser
  main-is:             Main.hs
  build-depends:
      base >=4.13 && <5
    , parser
    , optparse-applicative
  hs-source-dirs:      app
  default-language:    Haskell2010

test-suite parser-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  other-modules:
      Division
  build-depends:
      base >=4.13 && <5
    , parser
    , QuickCheck
    , aeson
    , bytestring
  hs-source-dirs:      test
  default-language:    Haskell2010